# Example run configuration for scripts/rl_ft/array_element.sh (committed, so a
# cluv submission pins it with the code). Paths come from the cluster (TAR_ROOT).
#   cluv submit <cluster> --chunking 3 --time=72:00:00 --ntasks=4 --gpus-per-task=h100:1 \
#       --cpus-per-task=6 --mem-per-gpu=64G --switches=1@00:30:00 --signal=B:USR1@600 \
#       -- bash scripts/rl_ft/array_element.sh scripts/rl_ft/configs/janusmulti_r3_reset.env
export RUN_NAME=rl_pixel_sft_t21_ck17000_janusmulti_r3_reset_g8p8_ep2_kl001_lr1e4_uv
export MAX_STEPS=500
export OBJECTIVE=janus_multi_iteration MAX_REFINEMENTS=3 RESET_CONTEXT_PER_TURN=1
export PROMPTS_PER_GPU=8 NUM_ROLLOUTS=8 GEN_BATCH_SIZE=32 RENDER_BATCH_SIZE=24
export NUM_PPO_EPOCHS=2 LR=1e-4 KL_COEF=0.01 ADV_NORM=std KL_GRADIENT_CORRECTION=1
export SEED=421
